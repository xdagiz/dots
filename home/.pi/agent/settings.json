{
  "compaction": {
    "enabled": false
  },
  "defaultModel": "deepseek-v4-flash-free",
  "defaultProvider": "opencode",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "httpIdleTimeoutMs": 1800000,
  "lastChangelogVersion": "0.84.1",
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@ff-labs/pi-fff",
    "git:github.com/earendil-works/pi-review",
    {
      "source": "npm:@bacnh85/pi-plan",
      "extensions": [
        "-extensions/index.ts"
      ]
    },
    "npm:pi-subagents",
    "npm:@narumitw/pi-goal",
    {
      "extensions": [
        "-src/index.ts"
      ],
      "source": "npm:pi-rewind"
    },
    "npm:pi-tuicr",
    "npm:pi-token-stats"
  ],
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 3000,
    "enabled": true,
    "maxRetries": 15,
