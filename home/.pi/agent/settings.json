{
  "compaction": {
    "enabled": false
  },
  "excludeTools": [
    "grep",
    "find"
  ],
  "defaultModel": "muse-spark-1.3-contributor-free",
  "defaultProvider": "opencode",
  "defaultThinkingLevel": "high",
  "extensions": [
    "+extensions/cline-pi-provider.ts",
    "-extensions/herdr-agent-state.ts",
    "+extensions/pi-undo/index.ts",
    "-extensions/auto-title/index.ts"
  ],
  "hideThinkingBlock": false,
  "httpIdleTimeoutMs": 1800000,
  "lastChangelogVersion": "0.85.1",
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@ff-labs/pi-fff",
    "git:github.com/earendil-works/pi-review",
    {
      "extensions": [
        "-extensions/index.ts"
      ],
      "source": "npm:@bacnh85/pi-plan"
    },
    {
      "source": "npm:pi-subagents",
      "extensions": [
        "-index.ts"
      ],
      "skills": [
        "-skills/pi-subagents/SKILL.md"
      ],
      "prompts": [
        "-prompts/gather-context-and-clarify.md",
        "-prompts/parallel-cleanup.md",
        "-prompts/parallel-research.md",
        "-prompts/parallel-review.md",
        "-prompts/review-loop.md"
      ]
    },
    "npm:@narumitw/pi-goal",
    {
      "extensions": [
        "-src/index.ts"
      ],
      "source": "npm:pi-rewind"
    },
    {
      "source": "npm:@tintinweb/pi-subagents",
      "extensions": [
        "+src/index.ts"
      ]
    },
    "npm:pi-context-view",
    "npm:@narumitw/pi-plan-mode",
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": [
        "-dist/extensions/agent-browser/index.js"
      ]
    },
    "npm:pi-session-finder",
    "npm:@ogulcancelik/pi-session-recall"
  ],
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 3000,
    "enabled": true,
    "maxRetries": 15,
    "provider": {
      "maxRetries": 5,
      "maxRetryDelayMs": 120000,
      "timeoutMs": 3600000
    }
  },
  "skills": [
    "-skills/understand-diff/SKILL.md",
    "-skills/understand/SKILL.md",
    "-skills/understand-chat/SKILL.md",
    "-skills/understand-dashboard/SKILL.md",
    "-skills/understand-domain/SKILL.md",
    "-skills/understand-explain/SKILL.md",
    "-skills/understand-knowledge/SKILL.md",
    "-skills/understand-onboard/SKILL.md"
  ],
  "subagents": {
    "agentOverrides": {
      "advisor": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "intercom",
          "web_search",
          "source_check",
          "fetch_content",
          "get_search_content"
        ]
      },
      "context-builder": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "web_search",
          "intercom",
          "source_check",
          "fetch_content",
          "get_search_content"
        ]
      },
      "delegate": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "web_search",
          "source_check",
          "fetch_content",
          "get_search_content"
        ]
      },
      "oracle": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "intercom",
          "web_search",
          "source_check",
          "fetch_content",
          "get_search_content"
        ]
      },
      "planner": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "write",
          "intercom",
          "web_search",
          "source_check",
          "fetch_content",
          "get_search_content"
        ]
      },
      "researcher": {
        "tools": [
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "intercom",
          "source_check"
        ]
      },
      "reviewer": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "intercom",
          "web_search",
          "source_check",
          "fetch_content",
          "get_search_content"
        ]
      },
      "scout": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "intercom",
          "web_search",
          "source_check",
          "fetch_content",
          "get_search_content"
        ]
      },
      "worker": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "web_search",
          "source_check",
          "fetch_content",
          "get_search_content"
        ]
      }
    }
  },
  "npmCommand": [
    "pnpm"
  ],
  "theme": "catppuccin-mocha",
  "tuiMode": "fullscreen",
  "transport": "websocket-cached",
  "websocketConnectTimeoutMs": 60000,
  "terminal": {
    "showTerminalProgress": true
  }
}