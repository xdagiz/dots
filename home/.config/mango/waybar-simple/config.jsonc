{
  "layer": "top",
  "position": "top",
  "ipc": false,
  "reload_style_on_change": true,
  "modules-left": ["ext/workspaces", "dwl/window#title", "custom/disk_io"],
  // "modules-center": [  ],
  "modules-right": [
    "group/tray-expander",
    "network",
    "cpu",
    "memory",
    "disk#root",
    "mpris",
    "pulseaudio",
    "clock",
    "custom/notification",
  ],
  "ext/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󱓻",
      "1": "1",
      "2": "2",
      "3": "3",
      "4": "4",
    },
    "ignore-hidden": false,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "on-scroll-up": "mmsg -d viewtoleft_have_client",
    "on-scroll-down": "mmsg -d viewtoright_have_client",
    "sort-by-id": true,
  },
  "dwl/window#title": {
    "format": "{title}",
    "max-length": 36,
    "on-click": "bash ~/.config/mango/scripts/screenshot.sh",
  },
  "memory": {
    "format": " {}%",
    "interval": 1,
    "states": {
      "critical": 80,
    },
    "on-click": "alacritty -e btop",
  },
  "cpu": {
    "interval": 1,
    "format": "󰍛 {usage}%",
    "states": {
      "critical": 80,
    },
    "on-click": "alacritty -e btop",
    "on-click-right": "alacritty",
  },
  "disk#root": {
    "interval": 30,
    "path": "/",
    "format": " {percentage_used}%",
    "tooltip": true,
  },
  "tray": {
    "spacing": 8,
    "icon-size": 12,
    "reverse-direction": true,
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:L%d %B %Y}",
    "tooltip": true,
    "tooltip-format": "{:L%d %B %Y}",
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}",
  },
  "network": {
    "format": "{icon}",
    "format-ethernet": "⇣{bandwidthDownBytes}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname} \nIP: {ipaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 1,
    "spacing": 1,
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{volume}%",
    "scroll-step": 2,
    "format-muted": " {volume}%",
    "format-icons": {
      "headphone": "",
      "default": ["", "", " "],
    },
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": "",
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#f38ba8'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='#f38ba8'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1s && swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout",
  },
  "custom/playerctl": {
    "format": "{2} <span>{0}</span>",
    "return-type": "json",
    "exec": "playerctl -p spotify metadata -f '{\"text\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}  {{ duration(position) }}/{{ duration(mpris:length) }}\", \"tooltip\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}  {{ duration(position) }}/{{ duration(mpris:length) }}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "tooltip": false,
    "on-click-middle": "playerctl -p spotify previous",
    "on-click": "playerctl -p spotify play-pause",
    "on-click-right": "playerctl -p spotify next",
    "on-click-forward": "playerctl -p spotify position 10+",
    "on-click-backward": "playerctl -p spotify position 10-",
    "on-scroll-up": "playerctl -p spotify volume 0.02+",
    "on-scroll-down": "playerctl -p spotify volume 0.02-",
    "format-icons": {
      "Paused": " ",
      "Playing": " ",
    },
  },
  "mpd": {
    "server": "127.0.0.1",
    "port": 6601,
    "format": "{stateIcon} {title} - {artist} ({elapsedTime:%M:%S}/{totalTime:%M:%S})",
    "format-disconnected": "Disconnected",
    "format-stopped": "Not playing",
    "interval": 1,
    "max-length": 10,
    "state-icons": {
      "playing": "▶",
      "paused": "⏸",
    },
    "on-click": "rmpc togglepause",
    "on-click-right": "rmpc next",
    "on-scroll-up": "rmpc volume +5",
    "on-scroll-down": "rmpc volume -5",
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": {
      "default": "▶",
      "spotify": "",
      "firefox": "",
      "chromium": " ",
    },
    "status-icons": {
      "paused": "⏸",
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "max-length": 20,
  },
  "custom/disk_io": {
    "exec": "~/.config/waybar/scripts/disk_io.sh",
    "interval": 1,
    "return-type": "json",
  },
}
